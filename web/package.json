{
  "name": "hennery-web",
  "private": true,
  "version": "0.3.7",
  "license": "AGPL-3.0-only",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build --config theme.config.ts && tsc -b && vite build && node --test scripts/*.test.mjs && node scripts/check-css-origins.mjs dist",
    "test": "vitest run",
    "typecheck": "tsc -b --noEmit && tsc -p tsconfig.node.json",
    "e2e": "node --test scripts/e2e/pwa-test-builds.test.mjs && sh ../packaging/pwa-test-builds.sh && sh e2e/build-push-notice.sh && playwright test"
  },
  "dependencies": {
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-markdown": "10.1.0",
    "rehype-highlight": "7.0.2",
    "rehype-sanitize": "6.0.0",
    "remark-breaks": "4.0.0",
    "remark-gfm": "4.0.1"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@tailwindcss/vite": "4.3.3",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.8",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "jsdom": "30.1.3",
    "tailwindcss": "4.3.3",
    "typescript": "7.0.2",
    "vite": "8.3.4",
    "vitest": "5.0.5"
  }
}
