{
  "$defs": {
    "ApiError": {
      "properties": {
        "code": {
          "type": "string"
        },
        "message": {
          "type": "string"
        },
        "session_id": {
          "description": "Set when the error leaves a session reachable by id (e.g. a session\nstart whose delivery is unknown: the session was created and may\nstill start, but the caller has no other way to learn its id).",
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "code",
        "message"
      ],
      "type": "object"
    },
    "AttachedSession": {
      "description": "A session that a host still has an adapter for, reported in `hello`.",
      "properties": {
        "last_seq": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "open_turn_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "session_id": {
          "type": "string"
        }
      },
      "required": [
        "session_id",
        "last_seq"
      ],
      "type": "object"
    },
    "CancelResponse": {
      "description": "`POST /api/sessions/{id}/cancel`: how the open turn ended. Usually\n`cancelled`, but `completed` or `failed` if the turn ended before the\ncancel reached the agent, and `interrupted` if the session was parked or\nclosed while the cancel was outstanding, or its adapter exited.",
      "properties": {
        "outcome": {
          "$ref": "#/$defs/TurnOutcome"
        },
        "turn_id": {
          "type": "string"
        }
      },
      "required": [
        "turn_id",
        "outcome"
      ],
      "type": "object"
    },
    "Capabilities": {
      "description": "`hello.capabilities`. Deserialized leniently: a capability this build\ndoes not know (a newer host, a minor protocol bump) is skipped, never a\nreason to refuse the whole `hello`. The generated schema still lists\n`Capability` as a closed `oneOf` (there is no open-ended JSON Schema\nequivalent), but that is a description of the known values, not a\nconstraint hennery itself enforces: an entry outside it is ignored, not\nrejected, so a schema-validating client or proxy must not reject a\n`hello` on an unknown capability either.",
      "items": {
        "$ref": "#/$defs/Capability"
      },
      "type": "array"
    },
    "Capability": {
      "description": "A feature a host implements, announced in `hello` (ACP core §3.3). The\ncollector never sends a frame that needs a capability to a host that\nlacks it.",
      "oneOf": [
        {
          "const": "projects",
          "description": "Project enumeration and browsing.",
          "type": "string"
        },
        {
          "const": "images",
          "description": "Image content blocks in prompts.",
          "type": "string"
        },
        {
          "const": "park",
          "description": "Explicit park (`park_session`).",
          "type": "string"
        }
      ]
    },
    "CollectorFrame": {
      "description": "Collector -> host.",
      "oneOf": [
        {
          "properties": {
            "collector_version": {
              "type": "string"
            },
            "committed": {
              "additionalProperties": {
                "format": "uint64",
                "minimum": 0,
                "type": "integer"
              },
              "description": "Highest committed seq per session listed in `hello`; the host\nfast-forwards its counters if they are lower (lost outbox).",
              "type": "object"
            },
            "protocol_version": {
              "type": "string"
            },
            "type": {
              "const": "hello_ack",
              "type": "string"
            }
          },
          "required": [
            "type",
            "protocol_version",
            "collector_version",
            "committed"
          ],
          "type": "object"
        },
        {
          "properties": {
            "code": {
              "type": "string"
            },
            "message": {
              "type": "string"
            },
            "type": {
              "const": "hello_error",
              "type": "string"
            }
          },
          "required": [
            "type",
            "code",
            "message"
          ],
          "type": "object"
        },
        {
          "description": "Model, mode and the other config axes of a session (ACP core §3.3,\n§4.3): what a start asks for, and what a resume re-applies. `model` and\n`mode` are the values of the adapter's model and mode options; `axes`\nholds every other option, by config id. Flattened into the frames and\nthe start request, so the wire stays `model?, mode?, axes{}`.",
          "properties": {
            "agent": {
              "type": "string"
            },
            "axes": {
              "additionalProperties": {
                "$ref": "#/$defs/ConfigValue"
              },
              "type": "object"
            },
            "committed_seq": {
              "description": "The collector's highest committed seq for this session; the host\ncontinues from the larger of this and its own counter (§5.1).",
              "format": "uint64",
              "minimum": 0,
              "type": "integer"
            },
            "cwd": {
              "type": "string"
            },
            "mode": {
              "type": [
                "string",
                "null"
              ]
            },
            "model": {
              "type": [
                "string",
                "null"
              ]
            },
            "request_id": {
              "type": "string"
            },
            "session_id": {
              "type": "string"
            },
            "type": {
              "const": "start_session",
              "type": "string"
            }
          },
          "required": [
            "type",
            "request_id",
            "session_id",
            "committed_seq",
            "agent",
            "cwd"
          ],
          "type": "object"
        },
        {
          "description": "Attach a parked, closed or failed session again: spawn the adapter and\n`session/load` it with replay suppression (ACP core §4.3, §4.5).\nCompleted by `session_started` | `start_failed`, like a start.",
          "properties": {
            "agent": {
              "type": "string"
            },
            "agent_session_id": {
              "description": "The adapter's own session id, from the stored `session_started`:\nthe host keeps no copy across restarts.",
              "type": "string"
            },
            "axes": {
              "additionalProperties": {
                "$ref": "#/$defs/ConfigValue"
              },
              "type": "object"
            },
            "committed_seq": {
              "description": "Fast-forward the host's counter before the first frame (§5.1).",
              "format": "uint64",
              "minimum": 0,
              "type": "integer"
            },
            "cwd": {
              "type": "string"
            },
            "mode": {
              "type": [
                "string",
                "null"
              ]
            },
            "model": {
              "type": [
                "string",
                "null"
              ]
            },
            "request_id": {
              "type": "string"
            },
            "session_id": {
              "type": "string"
            },
            "type": {
              "const": "resume_session",
              "type": "string"
            }
          },
          "required": [
            "type",
            "request_id",
            "session_id",
            "committed_seq",
            "agent",
            "cwd",
            "agent_session_id"
          ],
          "type": "object"
        },
        {
          "properties": {
            "content": {
              "description": "ACP ContentBlocks, built by the frontend.",
              "items": true,
              "type": "array"
            },
            "request_id": {
              "type": "string"
            },
            "session_id": {
              "type": "string"
            },
            "turn_id": {
              "type": "string"
            },
            "type": {
              "const": "prompt",
              "type": "string"
            }
          },
          "required": [
            "type",
            "request_id",
            "session_id",
            "turn_id",
            "content"
          ],
          "type": "object"
        },
        {
          "description": "Stop the turn in flight: `session/cancel` to the adapter. Completed\nby that turn's `turn_ended` (ACP core §3.3, §4.4), whatever its\noutcome: a turn that finished first is not cancelled.",
          "properties": {
            "request_id": {
              "type": "string"
            },
            "session_id": {
              "type": "string"
            },
            "turn_id": {
              "type": "string"
            },
            "type": {
              "const": "cancel_turn",
              "type": "string"
            }
          },
          "required": [
            "type",
            "request_id",
            "session_id",
            "turn_id"
          ],
          "type": "object"
        },
        {
          "description": "Switch one config option of an attached session (`session/set_config_option`).\nCompleted by `config_applied` | `error` (ACP core §3.3).",
          "properties": {
            "config_id": {
              "type": "string"
            },
            "request_id": {
              "type": "string"
            },
            "session_id": {
              "type": "string"
            },
            "type": {
              "const": "set_config",
              "type": "string"
            },
            "value": {
              "$ref": "#/$defs/ConfigValue"
            }
          },
          "required": [
            "type",
            "request_id",
            "session_id",
            "config_id",
            "value"
          ],
          "type": "object"
        },
        {
          "properties": {
            "ack_seq": {
              "format": "uint64",
              "minimum": 0,
              "type": "integer"
            },
            "session_id": {
              "type": "string"
            },
            "type": {
              "const": "ack",
              "type": "string"
            }
          },
          "required": [
            "type",
            "session_id",
            "ack_seq"
          ],
          "type": "object"
        },
        {
          "description": "Completed by `session_parked{operator}` (ACP core §4.8).",
          "properties": {
            "request_id": {
              "type": "string"
            },
            "session_id": {
              "type": "string"
            },
            "type": {
              "const": "park_session",
              "type": "string"
            }
          },
          "required": [
            "type",
            "request_id",
            "session_id"
          ],
          "type": "object"
        },
        {
          "description": "Completed by `session_closed` (ACP core §4.8).",
          "properties": {
            "request_id": {
              "type": "string"
            },
            "session_id": {
              "type": "string"
            },
            "type": {
              "const": "close_session",
              "type": "string"
            }
          },
          "required": [
            "type",
            "request_id",
            "session_id"
          ],
          "type": "object"
        }
      ]
    },
    "ConfigRequest": {
      "description": "`POST /api/sessions/{id}/config`: switch one config option.",
      "properties": {
        "config_id": {
          "type": "string"
        },
        "value": {
          "$ref": "#/$defs/ConfigValue"
        }
      },
      "required": [
        "config_id",
        "value"
      ],
      "type": "object"
    },
    "ConfigValue": {
      "anyOf": [
        {
          "type": "boolean"
        },
        {
          "type": "string"
        }
      ],
      "description": "The value of one config option (ACP `session/set_config_option`): a\nselect's value id, or a boolean toggle's state."
    },
    "EventDto": {
      "description": "One stored timeline event, as served by REST and SSE.",
      "properties": {
        "body": true,
        "event_id": {
          "format": "int64",
          "type": "integer"
        },
        "host_seq": {
          "format": "uint64",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "kind": {
          "type": "string"
        },
        "session_id": {
          "type": "string"
        },
        "ts": {
          "type": "string"
        }
      },
      "required": [
        "event_id",
        "session_id",
        "kind",
        "body",
        "ts"
      ],
      "type": "object"
    },
    "HostFrame": {
      "description": "Host -> collector.",
      "oneOf": [
        {
          "properties": {
            "attached_sessions": {
              "items": {
                "$ref": "#/$defs/AttachedSession"
              },
              "type": "array"
            },
            "capabilities": {
              "$ref": "#/$defs/Capabilities",
              "default": [],
              "description": "What this host implements (a closed list, ACP core §3.3). Absent\nmeans none."
            },
            "host_id": {
              "type": "string"
            },
            "host_version": {
              "type": "string"
            },
            "protocol_version": {
              "type": "string"
            },
            "token": {
              "description": "Walking skeleton only: a shared development token. Replaced by an\nEd25519 proof of possession (ACP core §3.5).",
              "type": "string"
            },
            "type": {
              "const": "hello",
              "type": "string"
            }
          },
          "required": [
            "type",
            "protocol_version",
            "host_version",
            "host_id",
            "token",
            "attached_sessions"
          ],
          "type": "object"
        },
        {
          "description": "Every state-bearing fact is a sequenced frame: it goes through the host\noutbox and is acked (ACP core §3.3).",
          "properties": {
            "body": {
              "$ref": "#/$defs/SessionBody"
            },
            "seq": {
              "format": "uint64",
              "minimum": 0,
              "type": "integer"
            },
            "session_id": {
              "type": "string"
            },
            "type": {
              "const": "session",
              "type": "string"
            }
          },
          "required": [
            "type",
            "session_id",
            "seq",
            "body"
          ],
          "type": "object"
        },
        {
          "description": "A rejected request. Not outboxed: a rejection means nothing happened,\nso losing it only costs the collector a timeout.",
          "properties": {
            "code": {
              "type": "string"
            },
            "message": {
              "type": "string"
            },
            "request_id": {
              "type": "string"
            },
            "type": {
              "const": "error",
              "type": "string"
            }
          },
          "required": [
            "type",
            "request_id",
            "code",
            "message"
          ],
          "type": "object"
        },
        {
          "description": "Sent once per connection after the unacked outbox has been resent.\nThe collector reconciles `hello.attached_sessions` only after this\nframe, so a resent `turn_ended` is never duplicated by a synthesised\none (ACP core §5.2).",
          "properties": {
            "type": {
              "const": "resend_complete",
              "type": "string"
            }
          },
          "required": [
            "type"
          ],
          "type": "object"
        }
      ]
    },
    "Indexed": {
      "description": "Fields the collector may read from a session event. Closed set (ACP core §3.2).\n\nThe catalogue extracts (`config_options`, `current_model`,\n`current_mode`, `current_axes`) travel together: when `config_options`\nis present and not empty, the four are one snapshot of the adapter's\nconfig. An absent or empty `config_options` means \"no read-back\", never\n\"the adapter has no config\" (a response that failed to parse looks\nempty).",
      "properties": {
        "config_options": {
          "description": "The full config catalogue: the adapter's ACP `SessionConfigOption`\nobjects, for the UI. The collector stores it and never reads it.",
          "items": true,
          "type": [
            "array",
            "null"
          ]
        },
        "current_axes": {
          "additionalProperties": {
            "$ref": "#/$defs/ConfigValue"
          },
          "description": "The current value of every other option, by config id.",
          "type": [
            "object",
            "null"
          ]
        },
        "current_mode": {
          "description": "The current value of the mode option.",
          "type": [
            "string",
            "null"
          ]
        },
        "current_model": {
          "description": "The current value of the model option.",
          "type": [
            "string",
            "null"
          ]
        },
        "title": {
          "type": [
            "string",
            "null"
          ]
        },
        "turn_id": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "type": "object"
    },
    "LifecycleResponse": {
      "description": "Result of a park or close: the session's lifecycle once the request took\neffect (`parked` or `closed`).",
      "properties": {
        "lifecycle": {
          "type": "string"
        },
        "session_id": {
          "type": "string"
        }
      },
      "required": [
        "session_id",
        "lifecycle"
      ],
      "type": "object"
    },
    "OpenTurn": {
      "description": "A session's open turn, for the detail view.",
      "properties": {
        "state": {
          "description": "`sent` (not yet acknowledged by the adapter) or `started`.",
          "type": "string"
        },
        "turn_id": {
          "type": "string"
        }
      },
      "required": [
        "turn_id",
        "state"
      ],
      "type": "object"
    },
    "ParkReason": {
      "description": "Why a session was parked (ACP core §3.2).",
      "enum": [
        "idle",
        "adapter_exited",
        "operator"
      ],
      "type": "string"
    },
    "PromptRequest": {
      "properties": {
        "content": {
          "items": true,
          "type": "array"
        }
      },
      "required": [
        "content"
      ],
      "type": "object"
    },
    "PromptResponse": {
      "properties": {
        "turn_id": {
          "type": "string"
        }
      },
      "required": [
        "turn_id"
      ],
      "type": "object"
    },
    "SessionBody": {
      "description": "The body of a sequenced, outboxed session frame.",
      "oneOf": [
        {
          "description": "The adapter session exists. Resolves the collector's start waiter.\n`indexed` carries the catalogue after the start's config switches\n(ACP core §4.3, P-13).",
          "properties": {
            "agent_session_id": {
              "type": "string"
            },
            "indexed": {
              "$ref": "#/$defs/Indexed",
              "default": {}
            },
            "kind": {
              "const": "session_started",
              "type": "string"
            },
            "request_id": {
              "type": "string"
            }
          },
          "required": [
            "kind",
            "request_id",
            "agent_session_id"
          ],
          "type": "object"
        },
        {
          "description": "The host accepted a start but could not create the adapter session\n(spawn, `initialize` or `session/new` failed). Rejects the start waiter.",
          "properties": {
            "code": {
              "type": "string"
            },
            "kind": {
              "const": "start_failed",
              "type": "string"
            },
            "message": {
              "type": "string"
            },
            "request_id": {
              "type": "string"
            }
          },
          "required": [
            "kind",
            "request_id",
            "code",
            "message"
          ],
          "type": "object"
        },
        {
          "description": "The prompt reached the adapter. Resolves the collector's prompt waiter.",
          "properties": {
            "kind": {
              "const": "turn_started",
              "type": "string"
            },
            "request_id": {
              "type": "string"
            },
            "turn_id": {
              "type": "string"
            }
          },
          "required": [
            "kind",
            "request_id",
            "turn_id"
          ],
          "type": "object"
        },
        {
          "description": "An ACP message from the adapter, verbatim in `payload`.",
          "properties": {
            "indexed": {
              "$ref": "#/$defs/Indexed",
              "default": {}
            },
            "kind": {
              "const": "acp_update",
              "type": "string"
            },
            "payload": true
          },
          "required": [
            "kind",
            "payload"
          ],
          "type": "object"
        },
        {
          "properties": {
            "error": {
              "type": [
                "string",
                "null"
              ]
            },
            "kind": {
              "const": "turn_ended",
              "type": "string"
            },
            "outcome": {
              "$ref": "#/$defs/TurnOutcome"
            },
            "stop_reason": {
              "type": [
                "string",
                "null"
              ]
            },
            "turn_id": {
              "type": "string"
            }
          },
          "required": [
            "kind",
            "turn_id",
            "outcome"
          ],
          "type": "object"
        },
        {
          "description": "The adapter process is gone and the session is detached (idle reap,\nadapter exit, or an operator park). Completes `park_session`.",
          "properties": {
            "kind": {
              "const": "session_parked",
              "type": "string"
            },
            "reason": {
              "$ref": "#/$defs/ParkReason"
            }
          },
          "required": [
            "kind",
            "reason"
          ],
          "type": "object"
        },
        {
          "description": "The operator closed an attached session. Completes `close_session`.",
          "properties": {
            "kind": {
              "const": "session_closed",
              "type": "string"
            }
          },
          "required": [
            "kind"
          ],
          "type": "object"
        },
        {
          "description": "The adapter exited without being asked to (ACP core §2.3). Followed by\n`session_parked{adapter_exited}`. The stderr tail is scrubbed.",
          "properties": {
            "code": {
              "format": "int32",
              "type": [
                "integer",
                "null"
              ]
            },
            "kind": {
              "const": "adapter_exited",
              "type": "string"
            },
            "signal": {
              "format": "int32",
              "type": [
                "integer",
                "null"
              ]
            },
            "stderr_tail": {
              "type": "string"
            }
          },
          "required": [
            "kind",
            "stderr_tail"
          ],
          "type": "object"
        },
        {
          "description": "hennery's own diagnostic that is not state (ACP core §3.2): a failed\nre-apply, or update kinds dropped during `session/load` (§4.5).\n`note` is a machine code; `text` is scrubbed.",
          "properties": {
            "kind": {
              "const": "host_note",
              "type": "string"
            },
            "note": {
              "type": "string"
            },
            "text": {
              "type": "string"
            }
          },
          "required": [
            "kind",
            "note",
            "text"
          ],
          "type": "object"
        },
        {
          "description": "A `set_config` took effect: the catalogue the adapter answered with,\nthe authoritative read-back (ACP core §3.2). Resolves the collector's\nconfig waiter.",
          "properties": {
            "indexed": {
              "$ref": "#/$defs/Indexed",
              "default": {}
            },
            "kind": {
              "const": "config_applied",
              "type": "string"
            },
            "request_id": {
              "type": "string"
            }
          },
          "required": [
            "kind",
            "request_id"
          ],
          "type": "object"
        }
      ]
    },
    "SessionCatalog": {
      "description": "A session's config catalogue and its current values: `GET\n/api/sessions/{id}/catalog`, the answer to `POST …/config`, and the data\nof the SSE `catalog_changed` message (ACP core §9). Commands, plan and\nusage join it with the plans that produce them.",
      "properties": {
        "axes": {
          "additionalProperties": {
            "$ref": "#/$defs/ConfigValue"
          },
          "type": "object"
        },
        "config_options": {
          "description": "The adapter's ACP `SessionConfigOption` objects, as last reported.",
          "items": true,
          "type": "array"
        },
        "mode": {
          "type": [
            "string",
            "null"
          ]
        },
        "model": {
          "type": [
            "string",
            "null"
          ]
        },
        "session_id": {
          "type": "string"
        }
      },
      "required": [
        "session_id",
        "config_options"
      ],
      "type": "object"
    },
    "SessionDetail": {
      "description": "`GET /api/sessions/{id}` (ACP core §9): the list item plus the open turn.\nPending requests join it with permission handling.",
      "properties": {
        "activity": {
          "type": [
            "string",
            "null"
          ]
        },
        "agent": {
          "type": "string"
        },
        "cwd": {
          "type": "string"
        },
        "failure_reason": {
          "type": [
            "string",
            "null"
          ]
        },
        "host_id": {
          "type": "string"
        },
        "lifecycle": {
          "type": "string"
        },
        "open_turn": {
          "anyOf": [
            {
              "$ref": "#/$defs/OpenTurn"
            },
            {
              "type": "null"
            }
          ]
        },
        "presumed_parked": {
          "description": "Parked only because its host has been offline past the threshold\n(ACP core §5.3); the host may still be running it.",
          "type": "boolean"
        },
        "session_id": {
          "type": "string"
        }
      },
      "required": [
        "session_id",
        "host_id",
        "agent",
        "cwd",
        "lifecycle",
        "presumed_parked"
      ],
      "type": "object"
    },
    "StartSessionRequest": {
      "description": "`POST /api/sessions` (ACP core §9): `{host_id, agent, cwd, model?, mode?, axes?}`.",
      "properties": {
        "agent": {
          "type": "string"
        },
        "axes": {
          "additionalProperties": {
            "$ref": "#/$defs/ConfigValue"
          },
          "type": "object"
        },
        "cwd": {
          "type": "string"
        },
        "host_id": {
          "type": "string"
        },
        "mode": {
          "type": [
            "string",
            "null"
          ]
        },
        "model": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "host_id",
        "agent",
        "cwd"
      ],
      "type": "object"
    },
    "StartSessionResponse": {
      "properties": {
        "session_id": {
          "type": "string"
        }
      },
      "required": [
        "session_id"
      ],
      "type": "object"
    },
    "TurnOutcome": {
      "description": "How a turn ended. Exactly one `turn_ended` per accepted turn (ACP core §4.4).",
      "enum": [
        "completed",
        "cancelled",
        "failed",
        "interrupted"
      ],
      "type": "string"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "hennery protocol"
}
