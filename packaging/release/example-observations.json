{
  "homebrew": {
    "repository": "marcinwadon/homebrew-tap",
    "branch": "main",
    "environment": "release",
    "credential": "RELEASE_HOMEBREW_TOKEN",
    "kind": "fine-grained-pat",
    "repositories": [
      "marcinwadon/homebrew-tap"
    ],
    "permissions": {
      "contents": "write"
    },
    "scope_confirmed": false
  },
  "ghcr": {
    "repository": "marcinwadon/hennery",
    "actions_access": "read",
    "dedicated_credential": "GHCR_PUBLISH_TOKEN",
    "negative_push": {
      "credential": "GITHUB_TOKEN",
      "read_status": null,
      "push_status": null
    }
  },
  "crates": [
    {
      "crate": "hennery-proto",
      "repository": "marcinwadon/hennery",
      "workflow": "release.yml",
      "environment": "release"
    },
    {
      "crate": "hennery-kernel",
      "repository": "marcinwadon/hennery",
      "workflow": "release.yml",
      "environment": "release"
    },
    {
      "crate": "hennery-view",
      "repository": "marcinwadon/hennery",
      "workflow": "release.yml",
      "environment": "release"
    },
    {
      "crate": "hennery-host",
      "repository": "marcinwadon/hennery",
      "workflow": "release.yml",
      "environment": "release"
    },
    {
      "crate": "hennery-gateway",
      "repository": "marcinwadon/hennery",
      "workflow": "release.yml",
      "environment": "release"
    },
    {
      "crate": "hennery-sessions",
      "repository": "marcinwadon/hennery",
      "workflow": "release.yml",
      "environment": "release"
    },
    {
      "crate": "hennery",
      "repository": "marcinwadon/hennery",
      "workflow": "release.yml",
      "environment": "release"
    }
  ],
  "crates_bootstrap": {
    "publish_only": true,
    "crate_names": [
      "hennery",
      "hennery-gateway",
      "hennery-host",
      "hennery-kernel",
      "hennery-proto",
      "hennery-sessions",
      "hennery-view"
    ],
    "scope_confirmed": false,
    "revocation_required": true
  }
}
